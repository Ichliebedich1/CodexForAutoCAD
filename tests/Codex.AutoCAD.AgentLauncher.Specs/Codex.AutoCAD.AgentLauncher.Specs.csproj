<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(EnableAutoCad2016)' != 'true'">net8.0</TargetFramework>
    <TargetFrameworks Condition="'$(EnableAutoCad2016)' == 'true'">net45;net8.0</TargetFrameworks>
    <AssemblyName>Codex.AutoCAD.AgentLauncher.Specs</AssemblyName>
    <RootNamespace>Codex.AutoCAD.AgentLauncher.Specs</RootNamespace>
    <AutomaticallyUseReferenceAssemblyPackages Condition="'$(EnableAutoCad2016)' == 'true'">false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableAutoCad2016)' == 'true'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net45" Version="[1.0.3]">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime;build;native;contentfiles;analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Codex.AutoCAD.AgentLauncher\Codex.AutoCAD.AgentLauncher.csproj" AdditionalProperties="EnableAutoCad2016=$(EnableAutoCad2016)" />
  </ItemGroup>
</Project>
