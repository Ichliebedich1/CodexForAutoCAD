<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(EnableAutoCad2016)' != 'true'">net8.0</TargetFramework>
    <TargetFrameworks Condition="'$(EnableAutoCad2016)' == 'true'">net45;net8.0</TargetFrameworks>
    <Nullable>annotations</Nullable>
    <AssemblyName>Codex.AutoCAD.Host.2016.V2.Specs</AssemblyName>
    <RootNamespace>Codex.AutoCAD.Host.2016.V2.Specs</RootNamespace>
    <AutomaticallyUseReferenceAssemblyPackages Condition="'$(EnableAutoCad2016)' == 'true'">false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableAutoCad2016)' == 'true'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net45" Version="[1.0.3]">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime;build;native;contentfiles;analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Codex.AutoCAD.Contracts\Codex.AutoCAD.Contracts.csproj"
                      AdditionalProperties="EnableAutoCad2016=$(EnableAutoCad2016)" />
    <Compile Include="..\..\src\Codex.AutoCAD.Host.2016.ReadOnlyContext\ReadOnlyContextSnapshot.cs"
             Link="Host2016\ReadOnlyContextSnapshot.cs" />
    <Compile Include="..\..\src\Codex.AutoCAD.Host.2016\CadContextV2CapturePolicy.cs"
             Link="Host2016\CadContextV2CapturePolicy.cs" />
    <Compile Include="..\..\src\Codex.AutoCAD.Host.2016\CanonicalSelectionHashV2.cs"
             Link="Host2016\CanonicalSelectionHashV2.cs" />
    <Compile Include="..\..\src\Codex.AutoCAD.Host.2016\CadReadTypeStatistics.cs"
             Link="Host2016\CadReadTypeStatistics.cs" />
    <Compile Include="..\..\src\Codex.AutoCAD.Host.2016\CadContextJsonMapper.cs"
             Link="Host2016\CadContextJsonMapper.cs" />
    <Compile Include="..\..\src\Codex.AutoCAD.Host.2016\CadContextJsonV2Mapper.cs"
             Link="Host2016\CadContextJsonV2Mapper.cs" />
  </ItemGroup>
</Project>
