    </ProjectReference>
    <ProjectReference Include="..\Codex.AutoCAD.Ipc\Codex.AutoCAD.Ipc.csproj">
      <AdditionalProperties>EnableAutoCad2016=true</AdditionalProperties>
    </ProjectReference>
    <Reference Include="System" />
